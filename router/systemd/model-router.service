[Unit]
Description=Tailscale Multi-Compute Model Router
After=network-online.target tailscale-online.target
Wants=network-online.target tailscale-online.target

[Service]
Type=simple
User=ai-router
Group=ai-router
WorkingDirectory=/opt/tailscale-ai-guide
EnvironmentFile=/etc/tailscale-ai-router.env
ExecStart=/opt/tailscale-ai-guide/.venv/bin/uvicorn router.model_router:app --host 0.0.0.0 --port 18180
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/tailscale-ai-router

[Install]
WantedBy=multi-user.target
